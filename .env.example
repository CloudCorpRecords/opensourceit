# Opensourceit environment
PORT=4173
# Point the CLI / MCP server at a remote instance instead of the local data/db.json:
# OPENSOURCEIT_URL=https://opensourceit-nine.vercel.app

# Durable data store (recommended on serverless hosts like Vercel, where the
# filesystem is read-only and memory resets between instances):
# OSIT_DB_MODE=github
# GITHUB_TOKEN=<fine-grained PAT, Contents read/write on the repo below only>
# OSIT_DB_REPO=CloudCorpRecords/opensourceit
# OSIT_DB_BRANCH=data-live
